{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#scu-diploma","title":"\u5357\u5341\u5b57\u661f\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08SCU diploma\uff09\u6587\u51ed\u6a21\u7248\u53c2\u7167\u5c55\u793a","text":"<p>\u5728\u73b0\u4ee3\u793e\u4f1a\uff0c\u9ad8\u7b49\u6559\u80b2\u8bc1\u4e66\u4e0d\u4ec5\u662f\u4e2a\u4eba\u5b66\u672f\u80fd\u529b\u7684\u8bc1\u660e\uff0c\u66f4\u662f\u8fdb\u5165\u56fd\u9645\u804c\u573a\u3001\u7533\u8bf7\u66f4\u9ad8\u5b66\u4f4d\u4ee5\u53ca\u843d\u6237\u4e00\u7ebf\u57ce\u5e02\u7684\u201c\u6572\u95e8\u7816\u201d\u3002\u4f5c\u4e3a\u6fb3\u5927\u5229\u4e9a\u6781\u5177\u6d3b\u529b\u4e0e\u521b\u65b0\u7cbe\u795e\u7684\u516c\u7acb\u5b66\u5e9c\uff0c\u8be5\u6821\u7684\u5b66\u4f4d\u5728\u56fd\u9645\u4e0a\u4eab\u6709\u5f88\u9ad8\u7684\u8ba4\u53ef\u5ea6\u3002\u672c\u6587\u5c06\u56f4\u7ed5\u8be5\u6821\u7684\u6bd5\u4e1a\u8bc1\u4e66\u8bbe\u8ba1\u7ec6\u8282\u3001\u5b66\u672f\u542b\u91d1\u91cf\u4ee5\u53ca\u56de\u56fd\u540e\u7684\u5b66\u5386\u8ba4\u8bc1\u6d41\u7a0b\u8fdb\u884c\u6df1\u5ea6\u89e3\u6790\uff0c\u5e2e\u52a9\u5e7f\u5927\u7559\u5b66\u751f\u53ca\u76f8\u5173\u4ece\u4e1a\u4eba\u5458\u66f4\u5168\u9762\u5730\u4e86\u89e3\u8fd9\u4e00\u56fd\u9645\u6587\u51ed\u7684\u771f\u5b9e\u9762\u8c8c\u3002</p> <p></p>"},{"location":"#_1","title":"\u4e00\u3001 \u6fb3\u6d32\u6d77\u5916\u5b66\u4f4d\u8bc1\u4e66\u7684\u6392\u7248\u5e03\u5c40\u4e0e\u6838\u5fc3\u89c6\u89c9\u5143\u7d20","text":"<p>\u6d77\u5916\u9ad8\u7b49\u9662\u6821\u5728\u9881\u53d1\u5b66\u4f4d\u6587\u51ed\u65f6\uff0c\u5f80\u5f80\u6709\u7740\u6781\u4e3a\u4e25\u8c28\u7684\u89c6\u89c9\u8bc6\u522b\u7cfb\u7edf\u4e0e\u9632\u4f2a\u89c4\u8303\u3002\u4ece\u5357\u5341\u5b57\u661f\u5927\u5b66\u6700\u65b0\u7248\u672c\u7684\u6587\u51ed\u6837\u672c\u4e2d\uff0c\u6211\u4eec\u53ef\u4ee5\u6e05\u6670\u5730\u89c2\u5bdf\u5230\u5176\u72ec\u7279\u7684\u827a\u672f\u98ce\u683c\u4e0e\u89c4\u683c\uff1a</p> <ul> <li>\u9876\u90e8\u7684\u89c6\u89c9\u6807\u8bc6\uff08Logo\uff09\uff1a \u8bc1\u4e66\u4e0a\u65b9\u4e2d\u592e\u9192\u76ee\u5730\u5370\u6709\u8be5\u6821\u6807\u5fd7\u6027\u7684\u76fe\u5f62\u5fbd\u6807\uff0c\u7531\u84dd\u3001\u7eff\u3001\u9ec4\u7b49\u6e10\u53d8\u8272\u51e0\u4f55\u56fe\u5f62\u7ec4\u5408\u800c\u6210\uff0c\u4e0b\u65b9\u914d\u6709\u6807\u51c6\u7684\u5b66\u6821\u82f1\u6587\u5168\u79f0\u3002\u8272\u5f69\u9971\u6ee1\u4e14\u5c42\u6b21\u5206\u660e\uff0c\u662f\u8fa8\u522b\u6587\u51ed\u771f\u4f2a\u7684\u7b2c\u4e00\u89c6\u89c9\u7a97\u53e3\u3002</li> <li>\u4e3b\u4f53\u6587\u5b57\u4e0e\u5b57\u4f53\u9009\u62e9\uff1a \u8bc1\u4e66\u6b63\u6587\u91c7\u7528\u5178\u96c5\u7684\u82f1\u6587\u5b57\u4f53\u3002\u901a\u5e38\u9996\u5148\u5217\u51fa\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u82f1\u6587\u59d3\u540d\uff0c\u968f\u540e\u662f\u56fa\u5b9a\u8868\u8ff0\uff0c\u610f\u4e3a\u201c\u5728\u5c65\u884c\u4e86\u5927\u5b66\u89c4\u5b9a\u7684\u6240\u6709\u6761\u4ef6\u540e\uff0c\u4e8e\u672c\u65e5\u88ab\u6388\u4e88\u67d0\u67d0\u5b66\u4f4d\u201d\u3002</li> <li>\u4e13\u4e1a\u4e0e\u65b9\u5411\u7684\u6807\u6ce8\uff1a \u4e13\u4e1a\u540d\u79f0\u901a\u5e38\u4ee5\u52a0\u7c97\u653e\u5927\u5b57\u4f53\u5448\u73b0\u3002\u4f8b\u5982\u6837\u672c\u4e2d\u5c55\u793a\u7684\u5de5\u5546\u7ba1\u7406\u7855\u58eb\uff0c\u5e76\u5728\u4e0b\u65b9\u7528\u62ec\u53f7\u6807\u6ce8\u4e86\u5177\u4f53\u7ec6\u5206\u4e13\u4e1a\u65b9\u5411\uff0c\u5982\u201c\u4eba\u5458\u7ba1\u7406\u4e0e\u9886\u5bfc\u529b\u201d\uff0c\u683c\u5f0f\u5341\u5206\u89c4\u8303\u3002</li> <li>\u843d\u6b3e\u4e0e\u65e5\u671f\uff1a \u8bc1\u4e66\u4e0b\u534a\u90e8\u5206\u4f1a\u660e\u786e\u5199\u9053\u201c\u5728\u5927\u5b66\u516c\u7ae0\u7684\u89c1\u8bc1\u4e0b\u4e8e\u67d0\u5e74\u67d0\u6708\u67d0\u65e5\u9881\u53d1\u201d\u3002\u7d27\u968f\u5176\u540e\u7684\u662f\u4e24\u4f4d\u6838\u5fc3\u6821\u9886\u5bfc\uff08\u901a\u5e38\u4e3a\u6821\u76d1\u4e0e\u526f\u6821\u957f\uff09\u7684\u827a\u672f\u624b\u5199\u4f53\u7b7e\u540d\u3002</li> </ul>"},{"location":"#_2","title":"\u4e8c\u3001 \u8bc1\u4e66\u5e95\u90e8\u91d1\u5c5e\u94a2\u5370\u4e0e\u6570\u5b57\u8ba4\u8bc1\u5b89\u5168\u673a\u5236","text":"<p>\u4e3a\u4e86\u675c\u7edd\u6587\u51ed\u9020\u5047\u5e76\u786e\u4fdd\u5b66\u672f\u4e25\u8083\u6027\uff0c\u73b0\u4ee3\u56fd\u9645\u6587\u51ed\u5728\u9632\u4f2a\u5de5\u827a\u4e0a\u6295\u5165\u4e86\u5927\u91cf\u6280\u672f\u3002\u5357\u5341\u5b57\u661f\u5927\u5b66\u6bd5\u4e1a\u8bc1\u7684\u5e95\u90e8\u5305\u542b\u4e86\u4e24\u4e2a\u81f3\u5173\u91cd\u8981\u7684\u5b89\u5168\u5143\u7d20\uff1a</p>"},{"location":"#1","title":"1. \u538b\u7eb9\u91d1\u5c5e\u94a2\u5370","text":"<p>\u5728\u8bc1\u4e66\u5e95\u90e8\u7684\u6b63\u4e2d\u592e\uff0c\u8bbe\u8ba1\u6709\u4e00\u4e2a\u5706\u5f62\u952f\u9f7f\u72b6\u7684\u91d1\u5c5e\u538b\u7eb9\u94a2\u5370\u3002\u94a2\u5370\u8868\u9762\u51f9\u51f8\u6709\u81f4\uff0c\u7cbe\u7ec6\u5730\u523b\u6709\u5b66\u6821\u7684\u5b98\u65b9\u82f1\u6587\u6821\u5fbd\u7eb9\u7ae0\u548c\u6838\u5fc3\u6821\u8bad\u3002\u8fd9\u79cd\u7269\u7406\u94a2\u5370\u5373\u4f7f\u5728\u6570\u5b57\u5316\u65f6\u4ee3\u4f9d\u7136\u662f\u4e0d\u53ef\u6216\u7f3a\u7684\u9632\u4f2a\u624b\u6bb5\uff0c\u590d\u5370\u6216\u4f4e\u6280\u672f\u626b\u63cf\u5f88\u96be\u5b8c\u7f8e\u8fd8\u539f\u5176\u7acb\u4f53\u8d28\u611f\u3002</p>"},{"location":"#2","title":"2. \u7535\u5b50\u8bc1\u4e66\u7f16\u53f7\u7cfb\u7edf","text":"<p>\u5728\u94a2\u5370\u7684\u6b63\u4e0b\u65b9\uff0c\u5370\u6709\u4e00\u4e32\u552f\u4e00\u7684\u6570\u5b57\u7f16\u7801\u3002\u8fd9\u662f\u6bd5\u4e1a\u751f\u7684\u4e13\u5c5e\u5b66\u672f\u6863\u6848\u7f16\u53f7\u3002\u5728\u6570\u5b57\u5316\u6559\u5b66\u7ba1\u7406\u7cfb\u7edf\u4e2d\uff0c\u901a\u8fc7\u5b98\u65b9\u6307\u5b9a\u7684\u65e0\u7eb8\u5316\u5e73\u53f0\uff0c\u96c7\u4e3b\u6216\u8ba4\u8bc1\u673a\u6784\u8f93\u5165\u8be5\u7f16\u53f7\u5373\u53ef\u77ac\u95f4\u6838\u5bf9\u6301\u8bc1\u4eba\u7684\u6bd5\u4e1a\u65f6\u95f4\u3001\u6240\u5b66\u4e13\u4e1a\u4ee5\u53ca\u5b66\u4f4d\u7684\u771f\u5b9e\u6027\uff0c\u5b9e\u73b0\u4e86\u7269\u7406\u9632\u4f2a\u4e0e\u6570\u5b57\u9632\u4f2a\u7684\u53cc\u91cd\u7ed3\u5408\u3002</p>"},{"location":"#_3","title":"\u4e09\u3001 \u8be5\u6821\u5de5\u5546\u7ba1\u7406\u53ca\u70ed\u95e8\u4e13\u4e1a\u7684\u56fd\u9645\u5b66\u672f\u58f0\u8a89","text":"<p>\u4e00\u4efd\u6587\u51ed\u7684\u4ef7\u503c\uff0c\u5f52\u6839\u7ed3\u5e95\u53d6\u51b3\u4e8e\u5176\u80cc\u540e\u7684\u5b66\u672f\u542b\u91d1\u91cf\u548c\u6559\u5b66\u8d28\u91cf\u3002\u8be5\u6821\u5728\u591a\u4e2a\u9ad8\u6807\u51c6\u5b66\u672f\u9886\u57df\u5747\u6709\u7740\u4eae\u773c\u7684\u8868\u73b0\uff1a</p> <ul> <li>\u5546\u79d1\u4e0e\u7ba1\u7406\u5b66\uff08MBA\uff09\uff1a \u8be5\u6821\u7684\u5de5\u5546\u7ba1\u7406\u7855\u58eb\u8bfe\u7a0b\u5728\u4e1a\u5185\u9887\u5177\u540d\u6c14\uff0c\u5c24\u5176\u662f\u9488\u5bf9\u4f01\u4e1a\u4e2d\u9ad8\u5c42\u7ba1\u7406\u4eba\u5458\u7684\u9886\u5bfc\u529b\u57f9\u8bad\u3001\u7ec4\u7ec7\u884c\u4e3a\u5b66\u7814\u7a76\u7b49\u8bfe\u7a0b\uff0c\u5b8c\u7f8e\u5951\u5408\u4e86\u5168\u7403\u8de8\u56fd\u4f01\u4e1a\u5bf9\u590d\u5408\u578b\u7ba1\u7406\u4eba\u624d\u7684\u9700\u6c42\u3002</li> <li>\u65c5\u6e38\u4e0e\u9152\u5e97\u7ba1\u7406\uff1a \u5f97\u76ca\u4e8e\u5176\u5730\u7406\u4f4d\u7f6e\uff08\u5982\u7d27\u90bb\u9ec4\u91d1\u6d77\u5cb8\u7b49\u8457\u540d\u65c5\u6e38\u80dc\u5730\uff09\uff0c\u8be5\u6821\u7684\u65c5\u6e38\u4e0e\u9152\u5e97\u7ba1\u7406\u4e13\u4e1a\u5728\u56fd\u9645\u4e0a\u540d\u5217\u524d\u8305\uff0c\u6bd5\u4e1a\u751f\u5728\u5168\u7403\u6b3e\u5f85\u4e1a\u53ca\u65c5\u6e38\u7ba1\u7406\u677f\u5757\u6781\u5177\u7ade\u4e89\u529b\u3002</li> <li>\u6d77\u6d0b\u79d1\u5b66\u4e0e\u73af\u5883\u5de5\u7a0b\uff1a \u5b66\u6821\u62e5\u6709\u591a\u4e2a\u9876\u5c16\u7684\u56fd\u5bb6\u7ea7\u7814\u7a76\u4e2d\u5fc3\uff0c\u5728\u751f\u6001\u5b66\u3001\u73af\u5883\u79d1\u5b66\u7b49\u9886\u57df\u7684\u79d1\u7814\u6210\u679c\u5c61\u83b7\u56fd\u9645\u5927\u5956\u3002</li> </ul>"},{"location":"#_4","title":"\u56db\u3001 \u7559\u5b66\u751f\u6bd5\u4e1a\u56de\u56fd\u540e\u7684\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u89c4\u8303\u6d41\u7a0b","text":"<p>\u5bf9\u4e8e\u4e2d\u56fd\u7559\u5b66\u751f\u800c\u8a00\uff0c\u987a\u5229\u62ff\u5230\u6d77\u5916\u6587\u51ed\u53ea\u662f\u7b2c\u4e00\u6b65\uff0c\u56de\u56fd\u540e\u5728\u56fd\u4f01\u5c31\u4e1a\u3001\u843d\u6237\u3001\u62a5\u8003\u516c\u52a1\u5458\u6216\u7ee7\u7eed\u6df1\u9020\uff0c\u90fd\u5fc5\u987b\u901a\u8fc7\u5b98\u65b9\u7684\u5b66\u5386\u8ba4\u8bc1\u3002\u4ee5\u4e0b\u662f\u6807\u51c6\u7684\u8ba4\u8bc1\u89c4\u8303\u4e0e\u907f\u5751\u6307\u5357\uff1a</p> <ol> <li>\u6750\u6599\u51c6\u5907\u9636\u6bb5\uff1a \u7533\u8bf7\u4eba\u9700\u8981\u51c6\u5907\u597d\u6e05\u6670\u7684\u6bd5\u4e1a\u8bc1\u4e66\u626b\u63cf\u4ef6\u3001\u62a4\u7167\u4e2a\u4eba\u4fe1\u606f\u9875\u3001\u5f80\u8fd4\u7b7e\u8bc1\u8bb0\u5f55\u4ee5\u53ca\u5b8c\u6574\u7684\u6210\u7ee9\u5355\u3002</li> <li>\u5b98\u65b9\u5e73\u53f0\u63d0\u4ea4\uff1a \u767b\u5f55\u7559\u5b66\u751f\u670d\u52a1\u4e2d\u5fc3\u6307\u5b9a\u7684\u5b98\u65b9\u5728\u7ebf\u7cfb\u7edf\uff0c\u6ce8\u518c\u4e2a\u4eba\u8d26\u6237\u5e76\u5728\u7ebf\u586b\u5199\u8be6\u7ec6\u7684\u7559\u5b66\u7ecf\u5386\uff0c\u6309\u8981\u6c42\u4e0a\u4f20\u6240\u6709\u7535\u5b50\u7248\u6750\u6599\u5e76\u7f34\u7eb3\u76f8\u5e94\u7684\u5ba1\u6838\u8d39\u7528\u3002</li> <li>\u9632\u4f2a\u4e0e\u771f\u5b9e\u6027\u6838\u67e5\uff1a \u8ba4\u8bc1\u673a\u6784\u5728\u6536\u5230\u7533\u8bf7\u540e\uff0c\u4f1a\u76f4\u63a5\u5411\u6d77\u5916\u53d1\u8bc1\u9662\u6821\u7684\u6559\u52a1\u7cfb\u7edf\u53d1\u51fa\u6838\u5b9e\u8bf7\u6c42\u3002\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\u6bd5\u4e1a\u8bc1\u4e0a\u7684\u7f16\u7801\u3001\u94a2\u5370\u7b49\u4fe1\u606f\u5fc5\u987b\u7edd\u5bf9\u771f\u5b9e\u65e0\u8bef\u7684\u539f\u56e0\u3002</li> <li>\u8ba4\u8bc1\u7ed3\u679c\u4e0b\u8f7d\uff1a \u5ba1\u6838\u901a\u8fc7\u540e\uff0c\u7cfb\u7edf\u5c06\u751f\u6210\u7535\u5b50\u7248\u7684\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u4e66\uff0c\u8be5\u8bc1\u4e66\u5e26\u6709\u5b98\u65b9\u7535\u5b50\u7b7e\u7ae0\u53ca\u9a8c\u8bc1\u4e8c\u7ef4\u7801\uff0c\u5168\u56fd\u7edf\u4e00\u8054\u7f51\u53ef\u67e5\u3002</li> </ol> <p>\u603b\u7ed3\u800c\u8a00\uff0c\u5357\u5341\u5b57\u661f\u5927\u5b66\u7684\u6bd5\u4e1a\u8bc1\u4e0d\u4ec5\u662f\u4e00\u5f20\u8bbe\u8ba1\u7cbe\u7f8e\u3001\u5de5\u827a\u4e25\u8c28\u7684\u7eb8\u8d28\u6587\u51ed\uff0c\u5e55\u540e\u66f4\u627f\u8f7d\u7740\u6301\u8bc1\u4eba\u56fd\u9645\u5316\u89c6\u91ce\u4e0e\u624e\u5b9e\u7684\u5b66\u672f\u529f\u5e95\u3002\u5145\u5206\u4e86\u89e3\u5176\u6837\u672c\u7279\u5f81\u4e0e\u8ba4\u8bc1\u6d41\u7a0b\uff0c\u80fd\u8ba9\u6bcf\u4e00\u4f4d\u5b66\u5b50\u7684\u7559\u5b66\u6295\u8d44\u53d1\u6325\u51fa\u6700\u5927\u7684\u793e\u4f1a\u4e0e\u804c\u573a\u4ef7\u503c\u3002</p>"}]}